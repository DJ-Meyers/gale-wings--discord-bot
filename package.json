{
  "name": "@galewings/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "register-commands": "tsx --env-file-if-exists=.env src/scripts/register-commands.ts"
  },
  "dependencies": {
    "@dj-meyers/gale-wings": "^2.2.0",
    "@dj-meyers/gale-wings--api-types": "^0.5.0",
    "@trpc/client": "^11.12.0",
    "@trpc/server": "^11.12.0",
    "discord.js": "^14.16.0",
    "pino": "^9.4.0",
    "superjson": "^2.2.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "pino-pretty": "^11.2.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.3",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  }
}
