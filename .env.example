# Discord
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Dev-only: register slash commands to one guild for instant updates (vs ~1h
# global). Get the snowflake from your test guild (Developer Mode → right-click).
# DISCORD_GUILD_ID=

# Gale Wings API
API_URL=http://localhost:8787

# Parser auth — must equal BOT_API_KEY on the api side. See discord-bot-plan.md
# §7.3 (local-dev row): any matching ≥32-char string works locally.
BOT_API_KEY=gwbot_local_dev_only_xxxxxxxxxxxxxxxxxx

# Pino log level. Default 'info'.
# LOG_LEVEL=info
